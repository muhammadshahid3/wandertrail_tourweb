# Copy to .env and edit.

# --- Local Docker (Postgres) -------------------------------------
# docker-compose.yml already sets DB_ENGINE/DB_HOST for you; you only
# need these if you want to change the defaults.
DB_USER=tour_user
DB_PASSWORD=tourpass123
DB_NAME=tour_booking

# --- AWS RDS (MySQL) ---------------------------------------------
# DB_ENGINE=mysql
# DB_HOST=your-db-instance.xxxxxxxxxx.us-east-1.rds.amazonaws.com
# DB_PORT=3306
# DB_NAME=tour_booking
# DB_USER=admin
# DB_PASSWORD=your-rds-password

SECRET_KEY=change_me_to_a_long_random_string

# Default admin account seeded automatically on first startup
DEFAULT_ADMIN_NAME=Super Admin
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=Admin@123
